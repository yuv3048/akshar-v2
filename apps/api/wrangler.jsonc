{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",

   "queues": {
    "producers": [
      {
        "queue": "akshar-otp-email",
        "binding": "AKSHAR_OTP_EMAIL"
      }
    ],
    "consumers": [
    {
      "queue": "akshar-otp-email",
      "max_batch_size": 10,
      "max_batch_timeout": 5
    }
    ]
  }
